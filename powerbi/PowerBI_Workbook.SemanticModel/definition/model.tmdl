model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DataFolder", "pipeline_deals", "pipeline_stage_stints", "sales_team", "dim_accounts", "dept_quarter_summary", "model_scores", "model_calibration", "model_backtest", "model_feature_importance", "model_explanations", "dq_reconciliation", "rejected_records", "_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref expression DataFolder

ref table pipeline_deals
ref table pipeline_stage_stints
ref table sales_team
ref table dim_accounts
ref table dept_quarter_summary
ref table model_scores
ref table model_calibration
ref table model_backtest
ref table model_feature_importance
ref table model_explanations
ref table dq_reconciliation
ref table rejected_records
ref table DimDate
ref table DimDepartment
ref table DimStage
ref table _Measures

ref cultureInfo en-US
