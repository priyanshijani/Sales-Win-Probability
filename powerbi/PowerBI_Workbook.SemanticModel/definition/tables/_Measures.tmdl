	measure 'Bookings L3M Label' = VAR d = [Bookings L3M Change %] RETURN IF ( ISBLANK ( d ), "no prior period", IF ( d >= 0, "▲ +", "▼ " ) & FORMAT ( d, "0.0%" ) & " vs prior 3 months" )
		displayFolder: KPI markers
