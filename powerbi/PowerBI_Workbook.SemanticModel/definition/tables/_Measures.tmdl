	measure 'EUR At Risk' = CALCULATE ( SUM ( pipeline_deals[amount_eur] ), pipeline_deals[is_at_risk] = TRUE () )
		formatString: #,0
		displayFolder: Velocity & risk
		lineageTag: 2d179701-276b-5621-8e42-dd507e398f95

	measure 'At Risk Deals' = CALCULATE ( COUNTROWS ( pipeline_deals ), pipeline_deals[is_at_risk] = TRUE () )
		formatString: #,0
		displayFolder: Velocity & risk
		lineageTag: cf385ca2-2ea9-5704-8b22-afe4f164b080

	measure 'At Risk % of Pipeline' = DIVIDE ( [EUR At Risk], [Open Pipeline EUR] )
		formatString: #,0
		displayFolder: Velocity & risk
		lineageTag: 4a8f72c2-1b5d-531d-823c-8c5631845d78

	measure 'Avg Days in Stage' = AVERAGE ( pipeline_stage_stints[days_in_stage] )
		formatString: 0.0
		displayFolder: Velocity & risk
		lineageTag: 34c40f0d-5410-502b-bbad-73e29a9a278e

	measure 'Median Days in Stage' = MEDIAN ( pipeline_stage_stints[days_in_stage] )
		formatString: 0.0
		displayFolder: Velocity & risk
		lineageTag: b43fe83e-60a4-5205-bb20-4c72f453d005

	measure 'Avg Sales Cycle Days' = AVERAGE ( pipeline_deals[sales_cycle_days] )
		formatString: 0.0
		displayFolder: Velocity & risk
		lineageTag: bf42d2a8-1ad1-5904-b24d-6ce2d70bc263

	measure 'Deals Reached Stage' =
			VAR n = SELECTEDVALUE ( DimStage[stage_order] )
			RETURN CALCULATE ( COUNTROWS ( pipeline_deals ), pipeline_deals[max_stage_reached] >= n )
		formatString: #,0
		displayFolder: Velocity & risk
		lineageTag: 27aefb8a-a981-5fba-9f8e-1212a86d46c3

	measure 'Stage Conversion %' =
			VAR n = SELECTEDVALUE ( DimStage[stage_order] )
			RETURN
			DIVIDE (
			CALCULATE ( COUNTROWS ( pipeline_deals ), pipeline_deals[max_stage_reached] >= n + 1 ),
			CALCULATE ( COUNTROWS ( pipeline_deals ), pipeline_deals[max_stage_reached] >= n )
			)
		formatString: 0.0%
		displayFolder: Velocity & risk
		lineageTag: ab65cf4a-6c0f-56e4-8122-e853ae0b161a

	measure 'Forecast Honesty Gap (pts)' =
			AVERAGEX (
			FILTER ( pipeline_deals, pipeline_deals[is_open] && NOT ISBLANK ( pipeline_deals[rep_probability] ) ),
			pipeline_deals[rep_probability] - pipeline_deals[governed_probability] * 100
			)
		formatString: 0.0
		displayFolder: Velocity & risk
		lineageTag: 4daef929-6a6c-5f7d-956c-ff1b68c58e63

	measure 'Quota YTD EUR' = SUM ( sales_team[prorated_quota_ytd_eur] )
		formatString: \€#,0
