table _Measures
	lineageTag: 059c4d9d-c952-5aba-8a95-87824a219b66

	measure 'Snapshot Date' = MAX ( pipeline_deals[snapshot_date] )
		formatString: dd mmm yyyy
		displayFolder: Context
		lineageTag: dd4c3f29-b03b-5963-b9e7-37ad229cb7e1

	measure 'Open Pipeline EUR' = CALCULATE ( SUM ( pipeline_deals[amount_eur] ), pipeline_deals[is_open] = TRUE () )
		formatString: \€#,0
		displayFolder: Pipeline health
		lineageTag: 6ce3824e-4fa5-5d6c-b592-b2c40b58a296

	measure 'Weighted Pipeline EUR' = SUM ( pipeline_deals[weighted_amount_eur] )
		formatString: \€#,0
		displayFolder: Pipeline health
		lineageTag: 33b375c4-eb37-54c7-ab6b-7614a1c191cd

	measure 'Open Deals' = CALCULATE ( COUNTROWS ( pipeline_deals ), pipeline_deals[is_open] = TRUE () )
		formatString: #,0
		displayFolder: Pipeline health
		lineageTag: cb24dca8-5d22-5ee7-8bec-c8970133e712

	measure 'Bookings EUR' = CALCULATE ( SUM ( pipeline_deals[amount_eur] ), pipeline_deals[is_won] = TRUE () )
		formatString: \€#,0
		displayFolder: Pipeline health
		lineageTag: e34597d3-8737-5ded-8da4-e69102c92373

	measure 'Won Deals' = CALCULATE ( COUNTROWS ( pipeline_deals ), pipeline_deals[is_won] = TRUE () )
		formatString: #,0
		displayFolder: Pipeline health
		lineageTag: 5c7393f3-5a47-5fd2-9b10-0ce78b2130c9

	measure 'Lost Deals' = CALCULATE ( COUNTROWS ( pipeline_deals ), pipeline_deals[is_lost] = TRUE () )
		formatString: #,0
		displayFolder: Pipeline health
		lineageTag: caf5a881-08d7-5a03-8aca-e9ee28cffcd0

	measure 'Avg Won Deal EUR' = DIVIDE ( [Bookings EUR], CALCULATE ( COUNTROWS ( pipeline_deals ), pipeline_deals[is_won] = TRUE (), NOT ISBLANK ( pipeline_deals[amount_eur] ) ) )
		formatString: \€#,0
		displayFolder: Pipeline health
		lineageTag: 4e3b3e8e-35a1-5fec-a99b-e9a30a423fdd

	measure 'Win Rate (count)' = DIVIDE ( [Won Deals], [Won Deals] + [Lost Deals] )
		formatString: 0.0%
		displayFolder: Pipeline health
		lineageTag: 234c9720-40f7-5bf9-821b-092d4b7fd362

	measure 'Win Rate (value)' =
			VAR won = [Bookings EUR]
			VAR lost = CALCULATE ( SUM ( pipeline_deals[amount_eur] ), pipeline_deals[is_lost] = TRUE () )
			RETURN DIVIDE ( won, won + lost )
		formatString: 0.0%
		displayFolder: Pipeline health
		lineageTag: 60ecc82e-e9a4-596f-ba82-a6b5b1fe2701

	measure 'Win Rate Last 12M' =
			CALCULATE (
			[Win Rate (count)],
			DATESBETWEEN ( DimDate[Date], EDATE ( [Snapshot Date], -12 ) + 1, [Snapshot Date] )
			)
		formatString: 0.0%
		displayFolder: Pipeline health
		lineageTag: d95079de-50a0-56ad-a3e4-241270e75056

	measure 'Target EUR' = SUM ( dept_quarter_summary[bookings_target_eur] )
		formatString: \€#,0
		displayFolder: Pipeline health
		lineageTag: 4aa9166f-4bbf-53d5-bf1a-9c5c9f974127

	measure 'Bookings vs Target %' = DIVIDE ( SUM ( dept_quarter_summary[bookings_eur] ), [Target EUR] )
		formatString: 0.0%
		displayFolder: Pipeline health
		lineageTag: f3bfcdc8-90dd-574e-8116-1c4077ee6dbf

	measure 'Pipeline Coverage x' = DIVIDE ( SUM ( dept_quarter_summary[open_pipeline_eur] ), [Target EUR] )   // healthy >= 3x
		formatString: 0.0\x
		displayFolder: Pipeline health
		lineageTag: 9a64c9bc-3d23-51a2-a975-b7050d9d33ad

	measure 'Commit EUR' = SUM ( dept_quarter_summary[commit_eur] )
