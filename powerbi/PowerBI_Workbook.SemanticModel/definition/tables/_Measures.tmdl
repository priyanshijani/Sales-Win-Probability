	measure 'Model vs CRM Label' = VAR d = ( [Selected Model Win Probability] - [Selected Governed Probability] ) * 100 RETURN IF ( ISBLANK ( d ), BLANK (), IF ( d >= 0, "▲ +", "▼ " ) & FORMAT ( d, "0" ) & " pts vs CRM stage default" )
		displayFolder: KPI markers
		lineageTag: cb1adab0-7997-5468-ba08-bb30b10bebf6

	measure 'Model vs CRM Color' = IF ( [Selected Model Win Probability] >= [Selected Governed Probability], [Color Good], [Color Bad] )
		displayFolder: KPI markers
		lineageTag: 27ca090a-35b7-5933-b50d-8a69fe9ecc41

	measure 'Impact Marker' = VAR d = [Impact (pts)] RETURN IF ( ISBLANK ( d ), BLANK (), IF ( d >= 0, "▲ +", "▼ " ) & FORMAT ( d, "0.0" ) )
		displayFolder: KPI markers
		lineageTag: e323adce-dc31-5310-8889-a83eb024ac6c

	measure 'Impact Color' = IF ( [Impact (pts)] >= 0, [Color Good], [Color Bad] )
		displayFolder: KPI markers
		lineageTag: 03bb7ca0-2e06-5886-b331-0e3fede340a8

	measure 'Gap vs Governed Marker' = VAR d = AVERAGE ( model_scores[model_vs_governed_pts] ) RETURN IF ( ISBLANK ( d ), BLANK (), IF ( d >= 0, "▲ +", "▼ " ) & FORMAT ( d, "0" ) & " pts" )
		displayFolder: KPI markers
		lineageTag: 7189bed6-7f7e-5fed-9d7f-9a88d4898a94

	measure 'Gap vs Governed Color' = IF ( AVERAGE ( model_scores[model_vs_governed_pts] ) >= 0, [Color Good], [Color Bad] )
		displayFolder: KPI markers
		lineageTag: 162c1919-3b4a-583e-892d-d96eb0172db6

	measure 'Trust Label' = IF ( [Trust Score %] = 1, "● All checks pass", "● " & ( [Checks Total] - [Checks Passed] ) & " checks failing" )
		displayFolder: KPI markers
		lineageTag: 113a523e-92c9-5ee3-b3e6-f8e1ab8beb3a

	measure 'Trust Color' = IF ( [Trust Score %] = 1, [Color Good], [Color Bad] )
		displayFolder: KPI markers
		lineageTag: 09c91ff8-625d-53b0-a700-1f66a0791335

	measure 'Check Status Marker' = VAR s = SELECTEDVALUE ( dq_reconciliation[status] ) RETURN IF ( ISBLANK ( s ), BLANK (), "● " & s )
		displayFolder: KPI markers
		lineageTag: 76509a26-f268-56fe-a1a5-cf68d5bef9d2

	measure 'Check Status Color' = IF ( SELECTEDVALUE ( dq_reconciliation[status] ) = "PASS", [Color Good], [Color Bad] )
		displayFolder: KPI markers
