	measure 'So What Pipeline' = "Next quarter's pipeline covers " & FORMAT ( [Next Quarter Coverage x], "0.0" ) & "x of target (healthy is 3.0x); bookings this quarter stand at " & FORMAT ( [Current Quarter Attainment %], "0%" ) & " of target."
		displayFolder: Page takeaways
		lineageTag: b1238729-196a-50ec-846b-ff0a8d9668d2

	measure 'So What Risk' = FORMAT ( [At Risk % of Pipeline], "0%" ) & " of open pipeline (€" & FORMAT ( [EUR At Risk] / 1000000, "0.0" ) & "M, " & FORMAT ( [At Risk Deals], "#,0" ) & " deals) is stuck, stale, past due or orphaned: start with the ranked list above."
		displayFolder: Page takeaways
		lineageTag: 0dc8d1d4-f404-5b3b-a869-a88e857e5785

	measure 'So What People' = "Win rate is " & FORMAT ( [Win Rate (count)], "0.0%" ) & " and reps rate open deals " & FORMAT ( [Forecast Honesty Gap (pts)], "+0.0;-0.0" ) & " pts versus the governed probabilities: review the managers in red."
		displayFolder: Page takeaways
		lineageTag: b7a0adda-16ef-5f7d-85e1-dda92cdaf81d

	measure 'So What Market' = "€" & FORMAT ( [Open Pipeline EUR] / 1000000, "0.0" ) & "M of open pipeline across " & FORMAT ( [Accounts], "#,0" ) & " accounts; the win rate differs a lot by region, so direct investment to the strongest regions."
		displayFolder: Page takeaways
		lineageTag: 5a92a386-7375-5656-a746-22a89b23b1e3

	measure 'So What Model' = "The model puts weighted pipeline at €" & FORMAT ( [Model Weighted Pipeline EUR] / 1000000, "0.0" ) & "M against €" & FORMAT ( [Governed Weighted (scored deals) EUR] / 1000000, "0.0" ) & "M under the CRM stage odds; " & FORMAT ( [Deals To Review], "#,0" ) & " deals differ by 25 points or more and need a review."
		displayFolder: Page takeaways
