                <FormulaField expression="DateTimeParse([Hire Date], &quot;%d/%m/%Y&quot;)" field="hire_date" size="10" type="Date" enabled="true" />
                <FormulaField expression="IIF(IsEmpty([Leave Date]), Null(), DateTimeParse([Leave Date], &quot;%d/%m/%Y&quot;))" field="leave_date" size="10" type="Date" enabled="true" />
                <FormulaField expression="IsNull([leave_date]) OR [leave_date] &gt; [User.SnapshotDate]" field="owner_is_active" size="1" type="Bool" enabled="true" />
                <FormulaField expression="ToNumber([Annual Quota (EUR)])" field="annual_quota_eur" size="8" type="Double" enabled="true" />
                <FormulaField expression="IIF([hire_date] &gt; &quot;2026-01-01&quot;, [hire_date], &quot;2026-01-01&quot;)" field="quota_start" size="10" type="Date" enabled="true" />
                <FormulaField expression="IIF([owner_is_active], [User.SnapshotDate], [leave_date])" field="quota_end" size="10" type="Date" enabled="true" />
                <FormulaField expression="[annual_quota_eur] * Max(0, DateTimeDiff([quota_end], [quota_start], &quot;days&quot;)) / 365" field="prorated_quota_ytd" size="8" type="Double" enabled="true" />
                <FormulaField expression="Lowercase([Full Name])" field="name_key" size="1073741823" type="V_WString" enabled="true" />
                <FormulaField expression="Lowercase(Left([Full Name],1) + &quot;. &quot; + Substring([Full Name], FindString([Full Name],&quot; &quot;)+1))" field="initial_key" size="1073741823" type="V_WString" enabled="true" />
              </FormulaFields>
            </Configuration>
